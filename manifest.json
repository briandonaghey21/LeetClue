{
  "manifest_version": 3,
  "name": "LeetClue",
  "version": "1.0",
  "description": "LeetCode extension to generate hints",
  "action": {
    "default_icon": {
      "16": "icons/LeetClueIcon.png",
      "32": "icons/LeetClueIcon.png",
      "48": "icons/LeetClueIcon.png",
      "128": "icons/LeetClueIcon.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["activeTab", "tabs", "scripting", "sidePanel"],
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/LeetClueIcon.png",
    "32": "icons/LeetClueIcon.png",
    "48": "icons/LeetClueIcon.png",
    "128": "icons/LeetClueIcon.png"
  }
}